{
  "name": "fliwright",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "cloud:init": "node packages/fliwright-cloud/fliwright-cloud init",
    "cloud:start": "node packages/fliwright-cloud/fliwright-cloud server",
    "cloud:health": "node packages/fliwright-cloud/fliwright-cloud health",
    "cloud:deploy": "node scripts/deploy-cloud.mjs server",
    "cloud:deploy-worker": "node scripts/deploy-cloud.mjs worker",
    "cloud:worker": "node packages/fliwright-cloud-worker/fliwright-worker",
    "build": "pnpm -r run build",
    "test": "pnpm --filter './packages/*' -r run test",
    "lint": "pnpm -r run lint",
    "harness:check": "node scripts/verify-harness.mjs",
    "harness:capabilities": "node scripts/generate-harness-capabilities.mjs",
    "harness:learn": "node scripts/capture-harness-memory.mjs",
    "plugin:check": "node scripts/check-codex-plugin.mjs",
    "plugin:marketplace": "node scripts/install-codex-plugin-marketplace.mjs",
    "plugin:reload": "pnpm plugin:sync && node scripts/reload-codex-plugin.mjs",
    "plugin:sync": "node scripts/sync-codex-plugin-skills.mjs",
    "package:check": "node scripts/verify-package-tarballs.mjs",
    "simulate:flow-clean": "node scripts/simulate-flow-clean.mjs",
    "docs:cli": "node scripts/generate-cli-command-docs.mjs",
    "docs:cli:check": "node scripts/generate-cli-command-docs.mjs --check",
    "test-plan": "node packages/test-plan/dist/cli.js"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "5.0.5",
    "vite": "^8.1.0"
  }
}
