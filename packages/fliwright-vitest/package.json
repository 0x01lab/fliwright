{
  "name": "@fliwright/vitest",
  "version": "0.1.0",
  "description": "Vitest fixtures and lifecycle integration for Fliwright Flutter E2E tests.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x01lab/fliwright.git",
    "directory": "packages/fliwright-vitest"
  },
  "bugs": { "url": "https://github.com/0x01lab/fliwright/issues" },
  "homepage": "https://github.com/0x01lab/fliwright#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js"
    },
    "./reporter": {
      "types": "./dist/RecoveryReporter.d.ts",
      "import": "./dist/RecoveryReporter.js",
      "default": "./dist/RecoveryReporter.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fliwright/core": "workspace:*",
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.5.0"
  }
}
