{
  "name": "@fliwright/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted team test queue, Mac worker and immutable report service.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fliwright-cloud": "dist/main.js"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc && vite build --config vite.config.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fliwright/core": "workspace:*",
    "@fliwright/cli": "workspace:*",
    "@fliwright/tdd": "workspace:*",
    "fastify": "^5.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.5.0",
    "vitest": "5.0.5",
    "vite": "^8.1.0"
  }
}
