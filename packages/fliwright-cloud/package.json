{
  "name": "@fliwright/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted team test queue, device management and immutable report server.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fliwright-cloud": "fliwright-cloud"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && vite build --config vite.config.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fliwright/core": "workspace:*",
    "@fliwright/cli": "workspace:*",
    "fastify": "^5.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "zod": "^3.25.76",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-label": "^2.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.21.0",
    "@tanstack/react-router": "^1.170.45",
    "d3-scale": "^4.0.2",
    "@fliwright/cloud-protocol": "workspace:*",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.5.0",
    "vitest": "5.0.5",
    "vite": "^8.1.0",
    "tailwindcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "happy-dom": "^21.0.3",
    "@types/d3-scale": "^4.0.9",
    "@types/ws": "^8.5.10"
  },
  "files": [
    "dist",
    "fliwright-cloud",
    "README.md",
    "deploy"
  ]
}
