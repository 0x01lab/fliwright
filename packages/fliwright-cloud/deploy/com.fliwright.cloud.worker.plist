<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.fliwright.cloud.worker.ios</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/fliwright/packages/fliwright-cloud/dist/main.js</string>
    <string>worker</string><string>/Users/cloud/.config/fliwright-cloud/worker-ios.json</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/ABSOLUTE/NODE/BIN:/ABSOLUTE/FLUTTER/BIN:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FLIWRIGHT_CLOUD_WORKER_TOKEN</key><string>REPLACE_IN_PRIVATE_COPY</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/Users/cloud/Library/Logs/fliwright-cloud-worker.log</string>
  <key>StandardErrorPath</key><string>/Users/cloud/Library/Logs/fliwright-cloud-worker-error.log</string>
</dict></plist>
