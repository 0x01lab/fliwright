{
  "dataRoot": "./data",
  "host": "127.0.0.1",
  "port": 4780,
  "publicUrl": "https://cloud.example.internal",
  "proxySecret": "env:FLIWRIGHT_CLOUD_PROXY_SECRET",
  "publicationSecret": "env:FLIWRIGHT_CLOUD_PUBLICATION_SECRET",
  "users": { "YOUR_GITLAB_USERNAME": "admin" },
  "ciTokens": [{ "name": "gitlab", "hash": "REPLACE_WITH_SHA256_OF_CI_TOKEN" }],
  "workerTokens": [],
  "targets": [{
    "id": "app", "name": "Flutter App", "repository": "git@gitlab.example.internal:team/app.git",
    "projectPath": ".", "entry": "lib/main_fliwright.dart",
    "suites": { "smoke": ".fliwright/tests/smoke.test.ts" }, "scenarios": ["clean"],
    "requiredCapabilities": [],
    "install": [
      { "program": "flutter", "args": ["pub", "get"] },
      { "program": "pnpm", "args": ["install", "--frozen-lockfile"] }
    ],
    "flutterArgs": ["--debug"], "timeoutMs": 1800000
  }],
  "workers": [],
  "retentionDays": 30,
  "minFreeBytes": 1073741824,
  "maxStorageBytes": 107374182400
}
