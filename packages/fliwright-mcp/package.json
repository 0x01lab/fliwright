{
  "name": "@fliwright/mcp",
  "version": "0.1.0",
  "description": "Optional MCP adapter for agent-driven Fliwright Flutter automation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x01lab/fliwright.git",
    "directory": "packages/fliwright-mcp"
  },
  "bugs": { "url": "https://github.com/0x01lab/fliwright/issues" },
  "homepage": "https://github.com/0x01lab/fliwright#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "bin": {
    "fliwright-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fliwright/cli": "workspace:*",
    "@fliwright/core": "workspace:*",
    "@fliwright/tdd": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "vitest": "4.1.11",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.5.0"
  }
}
