{
  "name": "@fliwright/vscode",
  "displayName": "Fliwright",
  "description": "VS Code tools for Fliwright Flutter E2E testing.",
  "version": "0.1.0",
  "private": true,
  "publisher": "fliwright",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/0x01lab/fliwright.git",
    "directory": "packages/fliwright-vscode"
  },
  "bugs": {
    "url": "https://github.com/0x01lab/fliwright/issues"
  },
  "homepage": "https://github.com/0x01lab/fliwright/tree/main/packages/fliwright-vscode#readme",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run bundle && pnpm run bundle:webview",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --outfile=dist/extension.js --sourcemap --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "bundle:webview": "esbuild src/webview/recording-canvas/app.tsx --bundle --format=iife --platform=browser --jsx=automatic --outfile=dist/webview/recordingCanvas.js --loader:.css=css --asset-names=webview/[name] --outbase=src --sourcemap",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration.mjs",
    "verify:release": "pnpm run lint && pnpm run test && pnpm run test:integration && pnpm run package",
    "package": "pnpm run build && node scripts/stage-vsix.mjs && cd .vsix-stage && pnpm dlx @vscode/vsce package --no-dependencies --out ../fliwright-vscode-0.1.0.vsix",
    "publish:vsce": "pnpm run verify:release && cd .vsix-stage && pnpm dlx @vscode/vsce publish --packagePath ../fliwright-vscode-0.1.0.vsix"
  },
  "activationEvents": [
    "onCommand:fliwright.reloadMocks",
    "onCommand:fliwright.reloadFormRules",
    "onCommand:fliwright.reloadScripts",
    "onCommand:fliwright.connect",
    "onCommand:fliwright.disconnect",
    "onCommand:fliwright.discoverVmService",
    "onCommand:fliwright.configureMcp",
    "onCommand:fliwright.takeScreenshot",
    "onCommand:fliwright.createMockConfig",
    "onCommand:fliwright.openMockConfig",
    "onCommand:fliwright.copyMockEndpoint",
    "onCommand:fliwright.copyMockRuleJson",
    "onCommand:fliwright.createFormRules",
    "onCommand:fliwright.openFormRules",
    "onCommand:fliwright.openScript",
    "onCommand:fliwright.insertFormFieldSelector",
    "onCommand:fliwright.addAnalyzedFieldToFormRules",
    "onCommand:fliwright.createFormRulesFromLastAnalyze",
    "onCommand:fliwright.appendLastAnalyzeToFormRules",
    "onCommand:fliwright.applyMockRule",
    "onCommand:fliwright.stopMockRule",
    "onCommand:fliwright.applyDefaultMocks",
    "onCommand:fliwright.stopSandbox",
    "onCommand:fliwright.analyzeForm",
    "onCommand:fliwright.fillForm",
    "onCommand:fliwright.fillFormWithRules",
    "onCommand:fliwright.runCurrentTest",
    "onCommand:fliwright.runWorkspaceTests",
    "onCommand:fliwright.runScript",
    "onCommand:fliwright.openFailure",
    "onCommand:fliwright.startRecording",
    "onCommand:fliwright.stopRecording",
    "onCommand:fliwright.insertRecordedTest",
    "onCommand:fliwright.openRecording",
    "onCommand:fliwright.refreshStateProviders",
    "onCommand:fliwright.readStateProvider",
    "onCommand:fliwright.overrideStateProvider",
    "onCommand:fliwright.watchStateProvider",
    "onCommand:fliwright.unwatchStateProvider",
    "onCommand:fliwright.copyStateProviderValue",
    "onCommand:fliwright.openRiverpodSetupHelp",
    "onCommand:fliwright.openVisualEditor",
    "onCommand:fliwright.openTraceViewer",
    "onCommand:fliwright.showLastTrace",
    "onCommand:fliwright.openRunViewer",
    "onCommand:fliwright.showLastRun",
    "onCommand:fliwright.viewTestRun",
    "onCommand:fliwright.viewScriptRun"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fliwright",
          "title": "Fliwright",
          "icon": "media/fliwright.svg"
        }
      ]
    },
    "views": {
      "fliwright": [
        {
          "id": "fliwright.devices",
          "name": "Devices"
        },
        {
          "id": "fliwright.mockApis",
          "name": "Mock APIs"
        },
        {
          "id": "fliwright.formData",
          "name": "Form Data"
        },
        {
          "id": "fliwright.scripts",
          "name": "Scripts"
        },
        {
          "id": "fliwright.tests",
          "name": "Tests"
        },
        {
          "id": "fliwright.state",
          "name": "State"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "fliwright.testEditor",
        "displayName": "Fliwright Test Editor",
        "selector": [
          { "filenamePattern": "**/*.test.ts" },
          { "filenamePattern": "**/*.spec.ts" }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "fliwright.connect",
        "title": "Fliwright: Connect to VM Service",
        "icon": "$(plug)"
      },
      {
        "command": "fliwright.disconnect",
        "title": "Fliwright: Disconnect VM Service",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "fliwright.discoverVmService",
        "title": "Fliwright: Refresh / Discover VM Service",
        "icon": "$(refresh)"
      },
      {
        "command": "fliwright.configureMcp",
        "title": "Fliwright: Configure MCP",
        "icon": "$(server-environment)"
      },
      {
        "command": "fliwright.takeScreenshot",
        "title": "Fliwright: Take App Screenshot",
        "icon": "$(device-camera)"
      },
      {
        "command": "fliwright.reloadMocks",
        "title": "Fliwright: Reload Mock Configs",
        "icon": "$(refresh)"
      },
      {
        "command": "fliwright.createMockConfig",
        "title": "Fliwright: Create Mock Config",
        "icon": "$(add)"
      },
      {
        "command": "fliwright.openMockConfig",
        "title": "Fliwright: Open Mock Config"
      },
      {
        "command": "fliwright.copyMockEndpoint",
        "title": "Fliwright: Copy Mock Endpoint"
      },
      {
        "command": "fliwright.copyMockRuleJson",
        "title": "Fliwright: Copy Mock Rule JSON"
      },
      {
        "command": "fliwright.applyMockRule",
        "title": "Fliwright: Apply Mock Rule",
        "icon": "$(play)"
      },
      {
        "command": "fliwright.stopMockRule",
        "title": "Fliwright: Stop Mock Rule",
        "icon": "$(debug-stop)"
      },
      {
        "command": "fliwright.applyDefaultMocks",
        "title": "Fliwright: Apply Default Mocks",
        "icon": "$(play)"
      },
      {
        "command": "fliwright.stopSandbox",
        "title": "Fliwright: Stop All Mock Routes",
        "icon": "$(debug-stop)"
      },
      {
        "command": "fliwright.reloadFormRules",
        "title": "Fliwright: Reload Form Rules",
        "icon": "$(refresh)"
      },
      {
        "command": "fliwright.reloadScripts",
        "title": "Fliwright: Reload Scripts",
        "icon": "$(refresh)"
      },
      {
        "command": "fliwright.createFormRules",
        "title": "Fliwright: Create Form Rules",
        "icon": "$(add)"
      },
      {
        "command": "fliwright.openFormRules",
        "title": "Fliwright: Open Form Rules"
      },
      {
        "command": "fliwright.openScript",
        "title": "Fliwright: Open Script"
      },
      {
        "command": "fliwright.insertFormFieldSelector",
        "title": "Fliwright: Insert Form Field Selector"
      },
      {
        "command": "fliwright.addAnalyzedFieldToFormRules",
        "title": "Fliwright: Add Analyzed Field to Form Rules"
      },
      {
        "command": "fliwright.createFormRulesFromLastAnalyze",
        "title": "Fliwright: Create Form Rules From Last Analyze",
        "icon": "$(new-file)"
      },
      {
        "command": "fliwright.appendLastAnalyzeToFormRules",
        "title": "Fliwright: Append Last Analyze to Form Rules",
        "icon": "$(add)"
      },
      {
        "command": "fliwright.analyzeForm",
        "title": "Fliwright: Analyze Current Form",
        "icon": "$(inspect)"
      },
      {
        "command": "fliwright.fillForm",
        "title": "Fliwright: Fill Current Form",
        "icon": "$(wand)"
      },
      {
        "command": "fliwright.fillFormWithRules",
        "title": "Fliwright: Fill Current Form With Rules",
        "icon": "$(wand)"
      },
      {
        "command": "fliwright.runCurrentTest",
        "title": "Fliwright: Run Current Test",
        "icon": "$(run)"
      },
      {
        "command": "fliwright.runWorkspaceTests",
        "title": "Fliwright: Run Workspace Tests",
        "icon": "$(run-all)"
      },
      {
        "command": "fliwright.runScript",
        "title": "Fliwright: Run Script",
        "icon": "$(run)"
      },
      {
        "command": "fliwright.openFailure",
        "title": "Fliwright: Open Failure Context",
        "icon": "$(open-preview)"
      },
      {
        "command": "fliwright.startRecording",
        "title": "Fliwright: Start Recording",
        "icon": "$(record)",
        "enablement": "!fliwright.recording.isRecording"
      },
      {
        "command": "fliwright.stopRecording",
        "title": "Fliwright: Stop Recording",
        "icon": "$(debug-stop)",
        "enablement": "fliwright.recording.isRecording"
      },
      {
        "command": "fliwright.insertRecordedTest",
        "title": "Fliwright: Insert Recorded Test",
        "icon": "$(insert)",
        "enablement": "fliwright.recording.hasPreview"
      },
      {
        "command": "fliwright.openRecording",
        "title": "Fliwright: Open Saved Recording",
        "icon": "$(history)"
      },
      {
        "command": "fliwright.refreshStateProviders",
        "title": "Fliwright: Refresh State Providers",
        "icon": "$(refresh)"
      },
      {
        "command": "fliwright.refreshTests",
        "title": "Fliwright: Refresh Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "fliwright.readStateProvider",
        "title": "Fliwright: Read State Provider",
        "icon": "$(eye)"
      },
      {
        "command": "fliwright.overrideStateProvider",
        "title": "Fliwright: Override State Provider",
        "icon": "$(replace)"
      },
      {
        "command": "fliwright.watchStateProvider",
        "title": "Fliwright: Watch State Provider",
        "icon": "$(eye)"
      },
      {
        "command": "fliwright.unwatchStateProvider",
        "title": "Fliwright: Unwatch State Provider",
        "icon": "$(eye-closed)"
      },
      {
        "command": "fliwright.copyStateProviderValue",
        "title": "Fliwright: Copy State Provider Value",
        "icon": "$(copy)"
      },
      {
        "command": "fliwright.openRiverpodSetupHelp",
        "title": "Fliwright: Open Riverpod Setup Help",
        "icon": "$(question)"
      },
      {
        "command": "fliwright.openVisualEditor",
        "title": "Fliwright: Open Visual Test Editor",
        "icon": "$(eye)"
      },
      {
        "command": "fliwright.openTraceViewer",
        "title": "Fliwright: Open Trace Viewer",
        "icon": "$(timeline)"
      },
      {
        "command": "fliwright.showLastTrace",
        "title": "Fliwright: Show Last Trace",
        "icon": "$(history)"
      },
      {
        "command": "fliwright.openRunViewer",
        "title": "Fliwright: Open Run Viewer",
        "icon": "$(list-tree)"
      },
      {
        "command": "fliwright.showLastRun",
        "title": "Fliwright: Show Last Run",
        "icon": "$(history)"
      },
      {
        "command": "fliwright.viewTestRun",
        "title": "Fliwright: View Test Run",
        "category": "Fliwright",
        "icon": "$(history)"
      },
      {
        "command": "fliwright.viewScriptRun",
        "title": "Fliwright: View Script Run",
        "category": "Fliwright",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fliwright.connect",
          "when": "view == fliwright.devices",
          "group": "navigation@1"
        },
        {
          "command": "fliwright.disconnect",
          "when": "view == fliwright.devices",
          "group": "navigation@2"
        },
        {
          "command": "fliwright.discoverVmService",
          "when": "view == fliwright.devices",
          "group": "navigation@3"
        },
        {
          "command": "fliwright.configureMcp",
          "when": "view == fliwright.devices",
          "group": "navigation@4"
        },
        {
          "command": "fliwright.takeScreenshot",
          "when": "view == fliwright.devices",
          "group": "navigation@5"
        },
        {
          "command": "fliwright.reloadMocks",
          "when": "view == fliwright.mockApis",
          "group": "navigation@1"
        },
        {
          "command": "fliwright.createMockConfig",
          "when": "view == fliwright.mockApis",
          "group": "navigation@2"
        },
        {
          "command": "fliwright.applyDefaultMocks",
          "when": "view == fliwright.mockApis",
          "group": "navigation@3"
        },
        {
          "command": "fliwright.stopSandbox",
          "when": "view == fliwright.mockApis",
          "group": "navigation@4"
        },
        {
          "command": "fliwright.reloadFormRules",
          "when": "view == fliwright.formData",
          "group": "navigation@1"
        },
        {
          "command": "fliwright.createFormRules",
          "when": "view == fliwright.formData",
          "group": "navigation@2"
        },
        {
          "command": "fliwright.analyzeForm",
          "when": "view == fliwright.formData",
          "group": "navigation@3"
        },
        {
          "command": "fliwright.createFormRulesFromLastAnalyze",
          "when": "view == fliwright.formData",
          "group": "navigation@4"
        },
        {
          "command": "fliwright.fillForm",
          "when": "view == fliwright.formData",
          "group": "navigation@5"
        },
        {
          "command": "fliwright.runScript",
          "when": "view == fliwright.scripts",
          "group": "navigation@1"
        },
        {
          "command": "fliwright.reloadScripts",
          "when": "view == fliwright.scripts",
          "group": "navigation@2"
        },
        {
          "command": "fliwright.runCurrentTest",
          "when": "view == fliwright.tests",
          "group": "navigation@1"
        },
        {
          "command": "fliwright.runWorkspaceTests",
          "when": "view == fliwright.tests",
          "group": "navigation@2"
        },
        {
          "command": "fliwright.refreshStateProviders",
          "when": "view == fliwright.state",
          "group": "navigation@1"
        },
        {
          "command": "fliwright.refreshTests",
          "when": "view == fliwright.tests",
          "group": "navigation@1"
        },
        {
          "command": "fliwright.openRiverpodSetupHelp",
          "when": "view == fliwright.state",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "fliwright.openMockConfig",
          "when": "view == fliwright.mockApis && viewItem =~ /mockEndpoint|mockRule|mockInvalid/",
          "group": "inline@1"
        },
        {
          "command": "fliwright.copyMockEndpoint",
          "when": "view == fliwright.mockApis && viewItem == mockEndpoint",
          "group": "2_copy@1"
        },
        {
          "command": "fliwright.copyMockRuleJson",
          "when": "view == fliwright.mockApis && viewItem =~ /mockRule/",
          "group": "2_copy@2"
        },
        {
          "command": "fliwright.applyMockRule",
          "when": "view == fliwright.mockApis && viewItem =~ /mockRule/",
          "group": "inline@2"
        },
        {
          "command": "fliwright.stopMockRule",
          "when": "view == fliwright.mockApis && viewItem == mockRuleApplied",
          "group": "inline@3"
        },
        {
          "command": "fliwright.openFormRules",
          "when": "view == fliwright.formData && viewItem =~ /formRulesFile|formRule|formInvalid/",
          "group": "inline@1"
        },
        {
          "command": "fliwright.analyzeForm",
          "when": "view == fliwright.formData && viewItem == formRulesFile",
          "group": "inline@2"
        },
        {
          "command": "fliwright.fillFormWithRules",
          "when": "view == fliwright.formData && viewItem == formRulesFile",
          "group": "inline@3"
        },
        {
          "command": "fliwright.appendLastAnalyzeToFormRules",
          "when": "view == fliwright.formData && viewItem == formRulesFile",
          "group": "inline@4"
        },
        {
          "command": "fliwright.addAnalyzedFieldToFormRules",
          "when": "view == fliwright.formData && viewItem == formAnalyzeField",
          "group": "inline@1"
        },
        {
          "command": "fliwright.insertFormFieldSelector",
          "when": "view == fliwright.formData && viewItem == formAnalyzeField",
          "group": "inline@2"
        },
        {
          "command": "fliwright.runScript",
          "when": "view == fliwright.scripts && viewItem == scriptFile",
          "group": "inline@1"
        },
        {
          "command": "fliwright.openScript",
          "when": "view == fliwright.scripts && viewItem == scriptFile",
          "group": "inline@2"
        },
        {
          "command": "fliwright.runCurrentTest",
          "when": "view == fliwright.tests && viewItem == testFile",
          "group": "inline@1"
        },
        {
          "command": "fliwright.viewTestRun",
          "when": "view == fliwright.tests && viewItem == testCase",
          "group": "inline@2"
        },
        {
          "command": "fliwright.viewScriptRun",
          "when": "view == fliwright.scripts && viewItem == scriptFile",
          "group": "inline@3"
        },
        {
          "command": "fliwright.readStateProvider",
          "when": "view == fliwright.state && viewItem == stateProvider",
          "group": "inline@1"
        },
        {
          "command": "fliwright.overrideStateProvider",
          "when": "view == fliwright.state && viewItem == stateProvider",
          "group": "inline@2"
        },
        {
          "command": "fliwright.watchStateProvider",
          "when": "view == fliwright.state && viewItem == stateProvider",
          "group": "inline@3"
        },
        {
          "command": "fliwright.unwatchStateProvider",
          "when": "view == fliwright.state && viewItem == stateProvider",
          "group": "inline@4"
        },
        {
          "command": "fliwright.copyStateProviderValue",
          "when": "view == fliwright.state && viewItem == stateProvider",
          "group": "2_copy@1"
        }
      ]
    },
    "configuration": {
      "title": "Fliwright",
      "properties": {
        "fliwright.mockDir": {
          "type": "string",
          "default": ".fliwright/mocks",
          "description": "Directory containing Fliwright API Mock JSON files."
        },
        "fliwright.mockIndex": {
          "type": "string",
          "default": ".fliwright/mocks/mock-index.json",
          "description": "Optional Fliwright mock index JSON file."
        },
        "fliwright.autoStartMockController": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start and configure the tool-side mock controller after connecting to a Flutter VM Service."
        },
        "fliwright.vmServiceUrl": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Flutter VM Service WebSocket URL used by Fliwright commands."
        },
        "fliwright.autoDiscoverVmService": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan common local Flutter VM Service ports when no URL is configured."
        },
        "fliwright.testGlob": {
          "type": "string",
          "default": "tests/**/*.test.ts",
          "description": "Workspace glob used to discover Fliwright test files."
        },
        "fliwright.runner": {
          "type": "string",
          "enum": [
            "vitest",
            "cli"
          ],
          "default": "vitest",
          "description": "Runner backend used by the VS Code test panel."
        },
        "fliwright.screenshotMode": {
          "type": "string",
          "enum": [
            "file",
            "base64",
            "off"
          ],
          "default": "file",
          "description": "Failure screenshot mode used by Fliwright test runs."
        },
        "fliwright.failureContextDir": {
          "type": "string",
          "default": ".fliwright/failures",
          "description": "Directory where Fliwright failure context JSON files are read from."
        },
        "fliwright.traceDir": {
          "type": "string",
          "default": ".fliwright/traces",
          "description": "Directory reserved for Fliwright trace artifacts."
        },
        "fliwright.formRulesDir": {
          "type": "string",
          "default": ".fliwright/forms",
          "description": "Directory containing Fliwright form rule JSON files."
        },
        "fliwright.formRulesFile": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional single form rules JSON file override."
        },
        "fliwright.formLocale": {
          "type": "string",
          "default": "zh_CN",
          "description": "Default locale for generated form data."
        },
        "fliwright.formPreviewBeforeFill": {
          "type": "boolean",
          "default": true,
          "description": "Preview generated form data before filling the current screen."
        },
        "fliwright.formDebug": {
          "type": "boolean",
          "default": false,
          "description": "Write detailed FormHelper analyze/fill timing logs to the Fliwright output channel."
        },
        "fliwright.formOperationTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Maximum time in milliseconds to wait for a FormHelper analyze/fill operation before surfacing a timeout."
        },
        "fliwright.codeLensEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Fliwright CodeLens actions in TypeScript test files."
        },
        "fliwright.scriptGlob": {
          "type": "string",
          "default": ".fliwright/scripts/**/*.{js,mjs,cjs}",
          "description": "Workspace glob used to discover runnable Fliwright scripts. Scripts are expected under .fliwright/scripts/."
        },
        "fliwright.traceMode": {
          "type": "string",
          "enum": ["off", "on-failure", "full"],
          "default": "on-failure",
          "description": "Trace capture mode for test runs. 'on-failure' captures screenshots only on failed steps. 'full' captures every step."
        }
      }
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fliwright/cli": "workspace:*",
    "@fliwright/core": "workspace:*",
    "@fliwright/plugin-riverpod": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
